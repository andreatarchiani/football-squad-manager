rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function activeMember(workspaceId) {
      return signedIn()
        && exists(memberPath(workspaceId))
        && get(memberPath(workspaceId)).data.status == 'active';
    }

    function memberRole(workspaceId) {
      return get(memberPath(workspaceId)).data.role;
    }

    function canEdit(workspaceId) {
      return activeMember(workspaceId)
        && memberRole(workspaceId) in ['owner', 'admin', 'editor'];
    }

    function isOwner(workspaceId) {
      return activeMember(workspaceId) && memberRole(workspaceId) == 'owner';
    }

    function canManageMembers(workspaceId) {
      return activeMember(workspaceId) && memberRole(workspaceId) in ['owner', 'admin'];
    }

    // Support tickets live in Firestore Spark; no extra server, email or Storage.
    // The account email is checked against the authenticated Firebase token,
    // never against user-controlled document fields.
    function supportAdmin() {
      return signedIn() &&
        request.auth.token.email == 'squadmanagersupport@gmail.com';
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn() && !supportAdmin()
        && request.resource.data.keys().hasOnly([
          'authorUid', 'authorEmail', 'authorName', 'description',
          'page', 'browser', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'authorUid', 'authorEmail', 'authorName', 'description',
          'page', 'browser', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 80
        && request.resource.data.browser is string
        && request.resource.data.browser.size() <= 500
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if supportAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow list: if supportAdmin();
      allow update: if supportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'progress', 'resolved']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'defaultWorkspaceId', 'displayName', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.defaultWorkspaceId is string
        && getAfter(/databases/$(database)/documents/workspaces/$(request.resource.data.defaultWorkspaceId)/members/$(uid)).data.status == 'active';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.defaultWorkspaceId == resource.data.defaultWorkspaceId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'accountRole', 'defaultTeamId', 'updatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['accountRole']) || request.resource.data.accountRole in ['Società', 'Allenatore', 'Collaboratore', 'Altro'])
        && (!request.resource.data.keys().hasAny(['defaultTeamId']) || request.resource.data.defaultTeamId is string);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow read: if activeMember(workspaceId);
      allow update: if isOwner(workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if isOwner(workspaceId);

      match /members/{memberId} {
        allow read: if activeMember(workspaceId);
        allow create: if signedIn()
          && memberId == request.auth.uid
          && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'role', 'status', 'displayName', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.role == 'owner'
          && request.resource.data.status == 'active';
        allow update: if canManageMembers(workspaceId)
          && memberId != get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId
          && request.resource.data.role in ['admin', 'editor', 'viewer']
          && request.resource.data.status in ['active', 'invited', 'disabled']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'status', 'displayName', 'updatedAt'
          ]);
        allow delete: if canManageMembers(workspaceId)
          && memberId != get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId;
      }

      match /teams/{teamId} {
        allow read: if activeMember(workspaceId);
        allow create, update, delete: if canEdit(workspaceId);

        match /seasons/{seasonId} {
          allow read: if activeMember(workspaceId);
          allow create, update, delete: if canEdit(workspaceId);

          match /squadMembers/{playerId} {
            allow read: if activeMember(workspaceId);
            allow create, update, delete: if canEdit(workspaceId);
          }

          match /jerseyReservations/{shirtNumber} {
            allow read: if activeMember(workspaceId);
            allow create, update, delete: if canEdit(workspaceId);
          }

          match /settings/{settingId} {
            allow read: if activeMember(workspaceId);
            allow create, update, delete: if canEdit(workspaceId);
          }
        }
      }

      match /players/{playerId} {
        allow read: if activeMember(workspaceId);
        allow create, update, delete: if canEdit(workspaceId);
      }

      match /formations/{formationId} {
        allow read: if activeMember(workspaceId);
        allow create, update, delete: if canEdit(workspaceId);
      }

      match /matches/{matchId} {
        allow read: if activeMember(workspaceId);
        allow create, update, delete: if canEdit(workspaceId);

        match /selections/{playerId} {
          allow read: if activeMember(workspaceId);
          allow create, update, delete: if canEdit(workspaceId);
        }
      }

      match /activity/{activityId} {
        allow read: if activeMember(workspaceId);
        allow create: if canEdit(workspaceId)
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
